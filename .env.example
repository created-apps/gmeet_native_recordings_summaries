# Google
GOOGLE_SERVICE_ACCOUNT_BASE64=
CALENDAR_EMAIL=

# Anthropic (summary + homework extraction)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Supabase (same project holds meetings and meeting_summaries)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cron schedule, defaults to the top of every hour
CRON_SCHEDULE=0 * * * *
CRON_TIMEZONE=Asia/Kolkata

# How many meetings to pick up per run
BATCH_SIZE=25

# Minutes a claim stays valid before another worker may retry it
CLAIM_TIMEOUT_MINUTES=30

# Hours after a call ends that we keep re-checking for a late transcript
TRANSCRIPT_GRACE_HOURS=24

# Recurring series share one Meet link, so each meeting row is matched to the
# conference in its own slot. Minutes of slack allowed on each side.
MATCH_WINDOW_MINUTES=45

# Zone to read meetings.meeting_time in (it is a bare `time` with no zone).
# Defaults to CRON_TIMEZONE.
MEETING_TIMEZONE=Asia/Kolkata

# --- Sharing + email -------------------------------------------------------

# reader | commenter
DRIVE_SHARE_ROLE=reader

# Hold the recap until the recording exists in Drive, so recipients get one
# email with everything rather than one now and another when it lands.
REQUIRE_RECORDING=true

# Master switch. Leave false until you have watched a DRY_RUN pass -- turning
# this on sends real mail to real students and mentors.
MAIL_ENABLED=false

# Logs what it would share and email, writes nothing to Google and sends no mail.
DRY_RUN=false

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Your Team <no-reply@example.com>"
MAIL_REPLY_TO=

# A processed meeting whose recap never sent is retried for this long, measured
# from when the summary was stored. Costs no Claude tokens -- the summary is
# read back from meeting_summaries.
NOTIFY_RETRY_HOURS=24
NOTIFY_BATCH_SIZE=25

# Optional: workspace/team metadata copied onto every summary row
WORKSPACE_ID=
MEETING_TYPE=mentor_session
